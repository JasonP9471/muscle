# Browser-safe TrainOS account sync configuration. This project ships with a
# public publishable-key fallback; set these to point a fork at another project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ENABLE_CLOUD_SYNC=true

# Optional public food database lookup
VITE_ENABLE_FOOD_DATABASE=false

# Server-only. Never rename these with a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_NUTRITION_MODEL=gpt-4.1-mini

# Demo/local mode remains functional with every optional value above unset.
VITE_DEMO_MODE=false
