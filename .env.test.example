# Copy to .env.test.local and replace the publishable key with `supabase status` output.
# The safety guard refuses hosted targets, including the TrainOS production project.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_FROM_SUPABASE_STATUS
VITE_ENABLE_CLOUD_SYNC=true
TRAINOS_TEST_SUPABASE_URL=http://127.0.0.1:54321
